# SealScan Backend -- Environment Variables
# Copy this file to .env and fill in values as needed.

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- Logging ----
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- Quality Thresholds (override in code via config/settings.py) ----
# These are not read from .env by default; edit settings.py directly.
# Listed here for documentation purposes only.
#
# QUALITY_MIN_WIDTH=320
# QUALITY_MIN_HEIGHT=320
# QUALITY_MIN_SHARPNESS=80.0
# QUALITY_MIN_BRIGHTNESS=30.0
# QUALITY_MAX_BRIGHTNESS=225.0
# QUALITY_MIN_CONTRAST=20.0
# QUALITY_MAX_NOISE=15.0
